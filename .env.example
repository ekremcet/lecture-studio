# Copy to .env and fill in. Never commit .env.
# Used by `npm run oberik:setup` (project setup as code) and by the app's "Import from .env" button.
OBERIK_PROJECT_ID=
# OBERIK_API_KEY is accepted as an alias.
OBERIK_PROJECT_KEY=pk_...
# Optional. Only used by oberik-setup.ts when the project has no OpenAI provider yet.
OPENAI_API_KEY=
# Optional. Model id exactly as the Oberik catalog lists it. Setup prints the catalog.
OBERIK_DEFAULT_MODEL=
# Optional. The Oberik subject the app runs as. Private documents are visible to the subject that uploaded
# them, so keep it stable once sources are indexed.
OBERIK_SUBJECT=
# Optional. Absolute path of the material repo to open at launch; otherwise the app asks for a folder.
LECTURE_REPO=
